# Runtime image for GoReleaser: the binary is already cross-compiled, so this
# stage only wraps it in a distroless base.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35

COPY kiri /kiri

EXPOSE 4443 8085
USER nonroot:nonroot

ENTRYPOINT ["/kiri"]

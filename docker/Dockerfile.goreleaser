# Runtime image for GoReleaser: the binary is already cross-compiled, so this
# stage only wraps it in a distroless base.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY kiri /kiri

EXPOSE 4443 8085
USER nonroot:nonroot

ENTRYPOINT ["/kiri"]
